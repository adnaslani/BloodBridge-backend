# Copy this file to .env only on the production host. Never commit the real .env.
PORT=5002
NODE_ENV=production
FRONTEND_ORIGIN=https://app.example.com
TOKEN_SECRET=generate-a-unique-random-secret-with-at-least-32-characters

COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_example
COGNITO_CLIENT_ID=exampleclientid

DB_HOST=bloodbridge-postgres.cx0mu0ky4c3u.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=bloodbridge
DB_USER=bloodbridgeadmin
DB_PASSWORD=store-this-in-aws-secrets-manager-or-ec2-environment
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Enable only after the real SNS topic and verified SES sender are set.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_MODE=sns
NOTIFICATION_WORKER_POLL_MS=5000
AWS_REGION=eu-central-1
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:eu-central-1:508139322792:bloodbridge-notifications-eu
SES_FROM_EMAIL=adnaslani@gmail.com

# API Gateway WebSocket management HTTPS endpoint, without a trailing slash.
WEBSOCKET_MANAGEMENT_ENDPOINT=https://API_ID.execute-api.eu-central-1.amazonaws.com/production
