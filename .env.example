PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5502
TOKEN_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Leave all three values empty to keep using only legacy local JWTs during migration.
# Once configured, the API accepts both local JWTs and Cognito access tokens.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloodbridge
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# Set DB_SSL=true in managed production databases. Keep certificate validation enabled unless your provider documents otherwise.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Use webhook locally, or sns in AWS. SNS messages are delivered to the email Lambda.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_MODE=webhook
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WORKER_POLL_MS=5000
SNS_NOTIFICATION_TOPIC_ARN=
# Required by the SNS email Lambda, e.g. noreply@your-verified-domain.example
SES_FROM_EMAIL=
# API Gateway management endpoint, no trailing slash. Enables websocket delivery for queued jobs.
WEBSOCKET_MANAGEMENT_ENDPOINT=
