PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5502
TOKEN_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloodbridge
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# Set DB_SSL=true in managed production databases. Keep certificate validation enabled unless your provider documents otherwise.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Enable only after configuring a relay that converts webhook events into your email/SMS provider calls.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WORKER_POLL_MS=5000
